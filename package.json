{
	"name": "gistblog",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bunx --bun next dev --turbopack",
		"build": "bunx --bun next build",
		"start": "bunx --bun next start",
		"lint": "bunx --bun next lint",
		"deploy": "bunx --bun opennextjs-cloudflare build && bunx --bun opennextjs-cloudflare deploy",
		"preview": "bunx --bun opennextjs-cloudflare build && bunx --bun opennextjs-cloudflare preview",
		"cf-typegen": "bunx --bun wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.3.0",
		"@radix-ui/react-label": "^2.1.7",
		"next": "15.4.6",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"swr": "^2.2.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.6.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4",
		"typescript": "^5",
		"wrangler": "^4.40.2"
	}
}